# SimVLA / latent_action pipeline environment configuration.
# Copy to paths.env, fill in your local paths, then `source paths.env`
# before running any stage.  paths.env is gitignored — never commit it.

# SmolVLM backbone (local dir or HF repo id)
export SIMVLA_SMOLVLM_MODEL='/datasets/models/smolvlm/SmolVLM-500M-Instruct'

# LIBERO dataset root: contains libero_10/ libero_goal/ libero_object/ libero_spatial/
export LIBERO_DATASETS='/datasets/liber-datasets'

# Workspace root: all metas / norm stats / LAM / z-labels / checkpoints go here
export SIMVLA_CHECKPOINTS='/datasets/models/simvla-model/model'

# Optional: checkpoint dir to resume training from ('' = start fresh)
export SIMVLA_RESUME_CKPT=''

# Weights & Biases (leave WANDB_API_KEY empty to disable wandb logging)
export WANDB_API_KEY=''
export WANDB_PROJECT='simvla'

# GPU configuration
export CUDA_DEVICES='0'
export NUM_GPUS=1

# Latent action dimension (must stay consistent across all stages)
export SIMVLA_Z_DIM=16
