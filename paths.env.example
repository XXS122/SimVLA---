# =============================================================================
# SimVLA machine-local configuration
#
# Copy to paths.env and edit for your machine:
#     cp paths.env.example paths.env
#
# paths.env is auto-sourced by train_smolvlm_*.sh and run_tts_sweep.sh,
# or load it manually before running any script:
#     source paths.env
#
# paths.env is gitignored — NEVER commit it (it contains API keys).
# =============================================================================

# Local SmolVLM backbone (directory with the HF model files), or leave the
# HF repo id if the machine has internet access
export SIMVLA_SMOLVLM_MODEL='HuggingFaceTB/SmolVLM-500M-Instruct'

# LIBERO dataset root: contains libero_10/ libero_goal/ libero_object/
# libero_spatial/ (each with *_demo.hdf5). Used by create_libero_meta.py
# and compute_libero_norm_stats.py as the default --data_dir
export LIBERO_DATASETS='/path/to/LIBERO-datasets'

# Root directory for training outputs (checkpoints land in
# $SIMVLA_CHECKPOINTS/simvla_libero_{small,large}/)
export SIMVLA_CHECKPOINTS='./runs'

# Checkpoint to resume training from (leave empty to train from scratch)
export SIMVLA_RESUME_CKPT=''

# Weights & Biases (leave WANDB_API_KEY empty to disable wandb logging)
export WANDB_API_KEY=''
export WANDB_PROJECT='simvla'

# Set to 1 when the machine has no internet access to the HF Hub
export HF_HUB_OFFLINE=1

# GPUs: comma-separated device ids and the number of training processes
export CUDA_DEVICES='0'
export NUM_GPUS=1

# Headless MuJoCo rendering for LIBERO evaluation (fixes
# "OpenGL.EGL has no attribute EGLDeviceEXT" on machines without EGL);
# requires libosmesa6-dev (apt) or mesalib (conda-forge)
export MUJOCO_GL=osmesa
export PYOPENGL_PLATFORM=osmesa
