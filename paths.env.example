# =============================================================================
# SimVLA local machine configuration TEMPLATE
# -----------------------------------------------------------------------------
# Copy this file to `paths.env`, fill in the real values, then:
#     source paths.env
# before launching training / evaluation.
#
# NOTE: `paths.env` is git-ignored on purpose — it holds machine-specific paths
#       and secrets (WANDB_API_KEY). NEVER commit the real paths.env.
# =============================================================================

# --- Model / data / checkpoint paths ---
export SIMVLA_SMOLVLM_MODEL='/path/to/SmolVLM-500M-Instruct'   # SmolVLM backbone (local dir or HF repo id)
export LIBERO_DATASETS='/path/to/libero-datasets'             # LIBERO dataset root (contains libero_10/ etc.)
export SIMVLA_CHECKPOINTS='/path/to/output/checkpoints'        # where checkpoints are written
export SIMVLA_RESUME_CKPT=''                                   # optional: checkpoint dir to resume from

# --- Weights & Biases ---
export WANDB_API_KEY='your-wandb-api-key-here'                 # DO NOT commit the real key
export WANDB_PROJECT='simvla'

# --- GPU configuration ---
export CUDA_DEVICES='0'        # comma-separated device ids, e.g. '0' or '0,1,2,3'
export NUM_GPUS=1              # number of processes for accelerate launch
